# URL the backend uses to reach your self-hosted Stash instance (no trailing slash).
# Used for GraphQL/media server-side; also mirrored as externalUrl when EXTERNAL is unset.
STASH_INTERNAL_URL=http://localhost:9999

# Optional: Stash API key from Settings -> Security -> API Key.
# Kept server-side so it is never exposed in the client bundle.
STASH_API_KEY=

# Optional browser-facing Stash URL for "Open Stash" / edit deep-links (/api/config).
# Omit to use STASH_INTERNAL_URL. Set empty (STASH_EXTERNAL_URL=) to hide those controls.
# Set explicitly when the browser cannot reach the INTERNAL hostname.
# STASH_EXTERNAL_URL=http://localhost:9999

# Number of items shown per page across all listing views (default: 60).
PAGE_SIZE=60

# Host port the container is published on (default: 7676).
STASH_HUB_PORT=7676

# Optional: gunicorn Uvicorn worker count in the Docker image. Blank defaults to
# 2x CPU cores because GraphQL and media streaming are I/O-bound, so extra workers
# help even when they outnumber cores. Local `uvicorn --reload` ignores this.
WEB_CONCURRENCY=
