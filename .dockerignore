# Build artefacts and dependencies (reinstalled/rebuilt inside the image).
**/node_modules
**/dist
**/__pycache__
**/*.pyc
**/.venv
**/venv

# Local env files - config is passed as runtime env vars instead.
.env
.env.local
.env.*.local

# Dev/editor noise.
.git
.github
.vscode
.claude
**/*.md
npm-debug.log*

# OS.
.DS_Store
Thumbs.db
